{
  "name": "corecheck",
  "private": true,
  "packageManager": "npm@11.6.1",
  "engines": {
    "node": ">=24.11"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "e2e"
  ],
  "scripts": {
    "postinstall": "turbo run build --filter=@corecheck/shared --output-logs=errors-only",
    "dev": "turbo run dev --filter=!@corecheck/mobile",
    "dev:web": "turbo run dev --filter=@corecheck/web...",
    "dev:admin": "turbo run dev --filter=@corecheck/admin...",
    "dev:api": "turbo run dev --filter=@corecheck/api...",
    "dev:mobile": "turbo run build --filter=@corecheck/shared && npm run start --workspace=@corecheck/mobile",
    "mobile:android": "npm run android --workspace=@corecheck/mobile",
    "mobile:ios": "npm run ios --workspace=@corecheck/mobile",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check": "turbo run lint typecheck test build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "npm run e2e -w @corecheck/e2e"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "turbo": "^2.11.8"
  }
}
